NODE_ENV=development
HTTPPORT=8444

# Allowed CORS origin(s), comma-separated — use * for development (default),
# restrict to your domain(s) in production
CORS_ORIGIN=*

# Optional — defaults to src/../logs if unset or not writable
LOG_DIR=

# Discord OAuth2 (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=_PLACEHOLDER_
DISCORD_CLIENT_SECRET=_PLACEHOLDER_
DISCORD_REDIRECT_URI=https://skribblex.sfalter.de/
